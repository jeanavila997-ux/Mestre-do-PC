{
  "name": "mestre-do-pc-v10",
  "version": "11.2.1",
  "description": "Mestre do PC V11 - Sistema de automação e manutenção de computadores Windows",
  "main": "mcp-server/index.js",
  "scripts": {
    "postinstall": "npm --prefix mcp-server install --no-audit --no-fund",
    "start": "cd mcp-server && node index.js",
    "dev": "cd mcp-server && npm start",
    "test": "node --test test/mestre-cli.test.js && npm --prefix mcp-server test",
    "test:cli": "node --test test/mestre-cli.test.js",
    "validate": "cd mcp-server && npm run validate",
    "deploy:hostinger": "pwsh scripts/deploy-hostinger.ps1",
    "deploy:vps": "pwsh -NoProfile -File scripts/deploy-vps.ps1",
    "build:package": "node scripts/build-package.cjs",
    "install:computer-use": "node scripts/install-computer-use.js",
    "ia": "node scripts/mestre-cli.js ia",
    "cli:status": "node scripts/mestre-cli.js status",
    "models:live": "node scripts/modelos-disponiveis.mjs",
    "turbo:diagnostico": "node scripts/mestre-cli.js turbo diagnostico",
    "turbo:otimizar": "node scripts/mestre-cli.js turbo otimizar"
  },
  "keywords": [
    "mcp",
    "mestre-do-pc",
    "windows-automation",
    "ollama",
    "system-tools",
    "ai-agent"
  ],
  "author": "Jean Carlos de Avila",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@qwen-code/cua-sdk": "^0.27.0"
  },
  "homepage": "https://github.com/jeanavila997-ux/Mestre-do-PC-V10#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeanavila997-ux/Mestre-do-PC-V10.git"
  },
  "bugs": {
    "url": "https://github.com/jeanavila997-ux/Mestre-do-PC-V10/issues"
  },
  "allowScripts": {
    "@qwen-code/cua-sdk@0.27.0": true
  }
}
